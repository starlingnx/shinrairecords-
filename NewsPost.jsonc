{
  "name": "NewsPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "News post title"
    },
    "category": {
      "type": "string",
      "description": "Category label (e.g. Label News, New Release)"
    },
    "date": {
      "type": "string",
      "description": "Display date string (e.g. May 2026)"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary shown on the card"
    },
    "content": {
      "type": "string",
      "description": "Full article body shown in the Read More modal"
    },
    "img": {
      "type": "string",
      "description": "Cover image URL"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order (lower = first)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
